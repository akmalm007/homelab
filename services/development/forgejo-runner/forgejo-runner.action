[Unit]
Description=Forgejo-Action

[Container]
ContainerName=forgejo-runner
Image=data.forgejo.org/forgejo/runner:11
Environment=DOCKER_HOST=unix://run/user/1000/podman/podman.sock
Volume=/home/garnet/development/forgejo-action/data:/data
Volume=/home/garnet/development/forgejo-action/config.yaml:/config.yaml

[Service]
Restart=always

[Install]
WantedBy=default.target


